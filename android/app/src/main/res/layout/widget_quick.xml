<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Note widget: a Take a note bar with list, voice, and drawing buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/quick_note"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_bg"
        android:contentDescription="@string/shortcut_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_note"
            android:tint="@color/widget_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_take_note"
            android:textColor="@color/widget_text_2"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/quick_list"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/shortcut_list"
        android:padding="10dp"
        android:src="@drawable/ic_widget_list"
        android:tint="@color/widget_text_2" />

    <ImageView
        android:id="@+id/quick_voice"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/shortcut_voice"
        android:padding="10dp"
        android:src="@drawable/ic_widget_mic"
        android:tint="@color/widget_text_2" />

    <ImageView
        android:id="@+id/quick_draw"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/shortcut_drawing"
        android:padding="10dp"
        android:src="@drawable/ic_widget_draw"
        android:tint="@color/widget_text_2" />
</LinearLayout>
