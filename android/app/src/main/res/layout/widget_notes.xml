<?xml version="1.0" encoding="utf-8"?>
<!-- Notes widget: pinned notes first, then the latest edits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notes_header"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notes_voice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/shortcut_voice"
            android:padding="9dp"
            android:src="@drawable/ic_widget_mic"
            android:tint="@color/widget_text_2" />

        <ImageView
            android:id="@+id/notes_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_fab_bg"
            android:contentDescription="@string/shortcut_note"
            android:padding="7dp"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_on_accent" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/notes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/notes_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/widget_empty"
            android:textColor="@color/widget_text_2"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
